+ *  accepted set. */
+const VALID_WIZARD_TASK_IDS = new Set<string>(WIZARD_TASKS.map((t) => t.id));
+function isValidWizardTaskId(value: unknown): value is WizardTaskId {
+  return typeof value === 'string' && VALID_WIZARD_TASK_IDS.has(value);
+}
