+  | 'cord_sponsor'
+  | 'veil_sponsor'
+  | 'coin_sponsor'
+  | 'candle_sponsor' {
+  switch (tier) {
+    case 'principal':
+      return 'principal_sponsor';
+    case 'cord':
+      return 'cord_sponsor';
+    case 'veil':
+      return 'veil_sponsor';
+    case 'coin':
+      return 'coin_sponsor';
+    case 'candle':
+      return 'candle_sponsor';
+  }
+}
