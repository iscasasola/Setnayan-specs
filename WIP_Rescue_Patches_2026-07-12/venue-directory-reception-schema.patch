+    canonicalServices: ['gown_designer', 'suit_designer'],
+    ceremonyType,
+    venueSetting,
+    excludeVendorIds: excludeMarketplaceIds,
+    limit: 15,
+  });
+
+  let emptyCopy: string;
+  switch (ceremonyType) {
