+          label: 'License number (when issued)',
+          type: 'text',
+          placeholder: 'Issued by your LGU',
+          maxLength: 64,
+        },
+      ]}
+      inFlightLabel="Application filed · waiting"
+      doneLabel="License in hand"
+    />
+  );
+}
