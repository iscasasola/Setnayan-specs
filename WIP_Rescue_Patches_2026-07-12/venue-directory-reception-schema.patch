+        <p className="mt-1 max-w-2xl text-sm text-ink/70">
+          One price, everything bundled. Locking a package locks every
+          included planning category to this vendor.
+        </p>
+      </header>
+
+      <div className="grid gap-4 sm:grid-cols-2">
