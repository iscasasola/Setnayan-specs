+      ) : null}
+    </div>
+  );
+}
+
+// ----------------------------------------------------------------------------
+// Contact card
+// ----------------------------------------------------------------------------
+
+function ContactCard({
+  contact,
+  vendorBusinessName,
+}: {
+  contact: MarketplaceContact | null;
+  vendorBusinessName: string;
+}) {
+  const hasAny =
