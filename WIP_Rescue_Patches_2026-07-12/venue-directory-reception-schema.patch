+}
+
+function ReviewsHero({ stats }: { stats: ReviewStatsRow }) {
+  const hero = stats.avg_rating_overall;
+  if (stats.total_count === 0) {
+    return (
+      <div className="flex items-center gap-3 rounded-md bg-cream/40 px-3 py-2">
