+// PAGE_SIZE is dynamic per breakpoint · computed inside the component as
+// `columnCount × ROWS_PER_PAGE`. The legacy fixed 15 was 3 cols × 5 rows;
+// the new range is 5 (mobile) to 25 (xl desktop).
+
+type Props = {
+  eventId: string;
+  taskId: WizardTaskId;
