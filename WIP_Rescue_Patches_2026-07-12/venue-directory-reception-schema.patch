+}
+
+function ProUpgradeCard({
+  icon: Icon,
+  eyebrow,
+  title,
+  tagline,
+  features,
+  priceLabel,
+  priceSubLine,
+  owned,
+  freeDuringPromo,
+  upgradeHref,
+}: {
