+            </p>
+          ) : null}
+        </div>
+      </header>
+
+      {/* Status pill */}
+      <div className="mt-4 flex items-center gap-2">
+        {isLocked ? (
+          <span className="inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.1em] text-emerald-800">
