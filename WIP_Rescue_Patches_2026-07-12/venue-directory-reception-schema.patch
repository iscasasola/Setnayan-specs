+  return baseRows.map((row) => {
+    const photoKey = photosByVendor.get(row.vendor_profile_id) ?? null;
+    return {
+      ...row,
+      primary_photo_url: photoKey
+        ? r2PublicUrl(R2_BUCKETS.media, photoKey)
+        : null,
+      verification_state:
+        verificationByVendor.get(row.vendor_profile_id) ?? null,
+    } as WizardVendorRec;
