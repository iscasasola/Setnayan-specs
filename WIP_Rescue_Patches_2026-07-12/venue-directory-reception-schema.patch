+              ? 'text-emerald-700'
+              : tone === 'muted'
+                ? 'text-ink/65'
+                : 'text-ink'
+        }`}
+      >
+        {value}
+      </dd>
+    </div>
+  );
+}
+
+function LineItemSection({
+  priceSource,
+  vendorControlledItems,
+  lineItems,
+  eventId,
+  vendorId,
+  vendorMarketplaceId,
+}: {
+  priceSource: VendorPriceSource;
