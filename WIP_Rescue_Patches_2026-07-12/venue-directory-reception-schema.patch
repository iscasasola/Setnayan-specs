+  query = query
+    .order('ad_rank', { ascending: false, nullsFirst: false })
+    .order('review_count', { ascending: false, nullsFirst: false })
+    .order('avg_rating_overall', { ascending: false, nullsFirst: false })
+    .limit(limit);
