+ */
+export function venueTypeToSetting(venueType: string): string | null {
+  switch (venueType) {
+    case 'hotel_ballroom':
+      return 'banquet_hall';
+    case 'garden':
+      return 'garden';
+    case 'beach':
+      return 'beach';
