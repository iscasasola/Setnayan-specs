+}
+
+function Money({
+  label,
+  value,
+  tone = 'default',
+}: {
+  label: string;
+  value: string;
+  tone?: 'default' | 'muted' | 'warn' | 'good';
+}) {
+  return (
+    <div className="rounded-md bg-ink/[0.03] p-2">
+      <dt className="font-mono text-[10px] uppercase tracking-[0.15em] text-ink/50">{label}</dt>
