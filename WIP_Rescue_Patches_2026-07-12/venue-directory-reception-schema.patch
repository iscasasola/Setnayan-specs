+
+const AUTO_SHARE_INVITE_TTL_DAYS = 90;
+
+function computeAutoShareExpiresAt(): string {
+  return new Date(Date.now() + AUTO_SHARE_INVITE_TTL_DAYS * 24 * 60 * 60 * 1000).toISOString();
