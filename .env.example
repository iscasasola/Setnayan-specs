# Setnayan V1 — environment template
#
# Copy this file to `.env.local` at the root of the rebuilt monorepo
# (apps/web/.env.local for Next.js to pick it up, or root .env.local if
# turborepo is configured to load from there).
#
# Never commit .env.local. Add it to .gitignore.
#
# Sources: API_Integration_Checklist.md, CLAUDE_Code_Build_Prompt.md,
# 0013_platform_stack_and_sync, 0035_observability.

# ============================================================================
# REQUIRED FOR V1 LAUNCH
# ============================================================================

# ----------------------------------------------------------------------
# Supabase — Singapore region (closest to PH, ~50ms to Manila/Cebu/Davao)
# Dashboard → Project Settings → API
# ----------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------
# Cloudflare R2 — PH region buckets
# Dashboard → R2 → Manage R2 API Tokens (create Object Read & Write token)
#
# Buckets to create up front (per CLAUDE_Code_Build_Prompt § Tech stack):
#   - setnayan-media           (couple photo galleries, monograms, QR images)
#   - setnayan-thread-files    (chat attachments, iteration 0019)
#   - setnayan-vendor-contracts (signed PDFs, iteration 0006)
#   - setnayan-samples         (template + music catalogue assets)
# ----------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=setnayan-media
R2_BUCKET_THREAD_FILES=setnayan-thread-files
R2_BUCKET_VENDOR_CONTRACTS=setnayan-vendor-contracts
R2_BUCKET_SAMPLES=setnayan-samples
R2_PUBLIC_URL=                # e.g. https://media.setnayan.com (custom domain on bucket)

# ----------------------------------------------------------------------
# Daily.co — video meetings (iteration 0019 chat-attached calls)
# Dashboard → Developers → API Keys
# ----------------------------------------------------------------------
DAILY_API_KEY=
DAILY_DOMAIN=                 # e.g. setnayan.daily.co

# ----------------------------------------------------------------------
# Resend — transactional email (iteration 0028)
# Verify the sending domain (SPF/DKIM/DMARC on setnayan.com) before launch
# ----------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_ADDRESS=hello@setnayan.com

# ----------------------------------------------------------------------
# Anthropic Claude API — AI Highlights (0011), Contract Intelligence (0032),
# Save-the-Date copy (0024), guided budget planning (0007)
# ----------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6      # cheap routing
ANTHROPIC_MODEL_PREMIUM=claude-opus-4-7        # premium renders

# ----------------------------------------------------------------------
# Observability (iteration 0035)
# ----------------------------------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
BETTER_STACK_SOURCE_TOKEN=

# ----------------------------------------------------------------------
# App-level
# ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000      # https://setnayan.com in prod
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001    # https://admin.setnayan.com in prod

# Secret for signing guest invitation session cookies (iteration 0002).
# Generate with: openssl rand -hex 32
GUEST_SESSION_SECRET=

# ============================================================================
# V1.5 — apply for accounts now (multi-week approval), wire later
# ============================================================================

# PayMongo — automated card / GCash / GrabPay (replaces apply-then-pay flow)
# PH KYC takes ~4 weeks; start application Week 0
# PAYMONGO_SECRET_KEY=
# PAYMONGO_PUBLIC_KEY=
# PAYMONGO_WEBHOOK_SECRET=

# GCash Merchant API — direct GCash integration (currently apply-then-pay)
# GCASH_MERCHANT_ID=
# GCASH_API_KEY=

# Twilio — SMS notifications (V1 is email-only; SMS deferred unless needed)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# AWS Rekognition — face matching for photo delivery (iteration 0009)
# Region ap-southeast-1; collection prefix per event
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-southeast-1
# REKOGNITION_COLLECTION_PREFIX=setnayan-event-
