+
+const _paymentRejectsStatus: Accepts<PaymentFields['status'], string> = false;
+
+test('payments: status is forbidden to the caller and pinned to pending', () => {
+  // `payments_insert_status_guard` forced a non-admin insert to 'pending'. Every
